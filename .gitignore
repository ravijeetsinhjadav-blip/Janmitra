# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
.venv/
env/
ENV/

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Node / Admin Dashboard
node_modules/
dist/
dist-ssr/
build/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Flutter / Dart
flutter/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
