# Database & Document backups (preserve folders with .gitkeep)
backups/database/*
!backups/database/.gitkeep
backups/documents/*
!backups/documents/.gitkeep

# Uploaded Citizen Documents Storage (Local disk storage)
storage/
backend/storage/
backend/storage/*
!backend/storage/.gitkeep


