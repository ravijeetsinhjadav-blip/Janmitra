# JanMitra Assist - Backend Environment Configuration Template
# Copy this file to .env and configure values for your local environment.

# Application Settings
PROJECT_NAME="JanMitra Assist API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (comma separated list)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# PostgreSQL Database Configuration (Phase 2)
# Using Psycopg 3 driver: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="janmitra_db"

# Optional Direct Database URL override (leave commented to use individual fields above)
# DATABASE_URL="postgresql+psycopg://postgres:your_postgres_password_here@localhost:5432/janmitra_db"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & Security Configuration (Phase 3)
# Generate a secure 256-bit random key in production: openssl rand -hex 32
JWT_SECRET_KEY="janmitra_dev_jwt_secret_key_change_in_production_min_32_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# SMTP Email & Password Recovery Configuration (Phase 11)
# For local development with Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@janmitra.gov.in"
SMTP_FROM_NAME="JanMitra Assist"
SMTP_USE_TLS=False
SMTP_USE_SSL=False
FRONTEND_BASE_URL="http://localhost:8080"
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Rate Limiting & Brute Force Protection (Phase 11)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# Document Vault & OCR Pipeline Configuration (Phase 5)
DOCUMENT_STORAGE_PATH="storage/documents"
MAX_DOCUMENT_FILE_SIZE_BYTES=10485760
ALLOWED_DOCUMENT_EXTENSIONS="pdf,jpg,jpeg,png"
# OCR Provider: 'google_cloud_vision' for live production or 'mock' for local development/testing
OCR_PROVIDER="mock"
# Absolute path to Google Cloud service account JSON key file (required if OCR_PROVIDER='google_cloud_vision')
# GOOGLE_APPLICATION_CREDENTIALS="C:/secrets/gcp-vision-credentials.json"
OCR_CONFIDENCE_THRESHOLD=0.70

# AI Advisory & RAG Pipeline Configuration (Phase 6)
# AI Provider: 'gemini' for live Google Gemini Cloud LLM or 'mock' for local development/testing
AI_PROVIDER="mock"
# Google Gemini API Key from Google AI Studio / GCP (required if AI_PROVIDER='gemini')
# GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-3.8-flash"
# Optional OpenAI-compatible provider configuration
# OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
RAG_TOP_K=3
DEFAULT_ADVISORY_LANGUAGE="en"

# Razorpay Payment & Subscription Configuration (Phase 7.2)
RAZORPAY_KEY_ID="rzp_test_janmitra_dev_key"
RAZORPAY_KEY_SECRET="janmitra_razorpay_secret_dev_32char"
RAZORPAY_WEBHOOK_SECRET="janmitra_webhook_secret_dev_32char"
RAZORPAY_CURRENCY="INR"
RAZORPAY_DEV_MODE=True

# Subscription Quota Limits
FREE_MONTHLY_DOC_ANALYSES_LIMIT=3
PREMIUM_MONTHLY_DOC_ANALYSES_LIMIT=30
FREE_MONTHLY_AI_GUIDANCE_LIMIT=5
PREMIUM_MONTHLY_AI_GUIDANCE_LIMIT=100

