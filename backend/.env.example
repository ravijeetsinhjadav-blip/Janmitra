# JanMitra Assist - Backend Environment Configuration Template
# Copy this file to .env and configure values for your local environment.

# Application Settings
PROJECT_NAME="JanMitra Assist API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (comma separated list)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# PostgreSQL Database Configuration (Phase 2)
# Using Psycopg 3 driver: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="janmitra_db"

# Optional Direct Database URL override (leave commented to use individual fields above)
# DATABASE_URL="postgresql+psycopg://postgres:your_postgres_password_here@localhost:5432/janmitra_db"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & Security Configuration (Phase 3)
# Generate a secure 256-bit random key in production: openssl rand -hex 32
JWT_SECRET_KEY="janmitra_dev_jwt_secret_key_change_in_production_min_32_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Challenge Configuration (Phase 3)
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEV_MODE=True
SMS_PROVIDER="development"

# Future Phase Placeholders (Do not use in Phase 3)
# OLLAMA_BASE_URL="http://localhost:11434"
# RAZORPAY_KEY_ID="rzp_test_placeholder"
# RAZORPAY_KEY_SECRET="placeholder_secret"

# Document Vault & OCR Pipeline Configuration (Phase 5)
DOCUMENT_STORAGE_PATH="storage/documents"
MAX_DOCUMENT_FILE_SIZE_BYTES=10485760
ALLOWED_DOCUMENT_EXTENSIONS="pdf,jpg,jpeg,png"
OCR_PROVIDER="google_cloud_vision"
# Path to service account JSON key file for Google Cloud Vision API
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account.json"
OCR_CONFIDENCE_THRESHOLD=0.70

