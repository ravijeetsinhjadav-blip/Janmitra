# JanMitra Assist - Backend Environment Configuration Template
# Copy this file to .env and configure values for your local environment.

# Application Settings
PROJECT_NAME="JanMitra Assist API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (comma separated list)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# PostgreSQL Database Configuration (Phase 2)
# Using Psycopg 3 driver: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="janmitra_db"

# Optional Direct Database URL override (leave commented to use individual fields above)
# DATABASE_URL="postgresql+psycopg://postgres:your_postgres_password_here@localhost:5432/janmitra_db"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Future Phase Placeholders (Do not use in Phase 2)
# OLLAMA_BASE_URL="http://localhost:11434"
# RAZORPAY_KEY_ID="rzp_test_placeholder"
# RAZORPAY_KEY_SECRET="placeholder_secret"
